# ---------- LLM ----------
# groq | gemini | xai | ollama 
LLM_PROVIDER=groq
LLM_TEMPERATURE=0.5

# Groq
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=

# Gemini
GOOGLE_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=

# xAI (optional)
XAI_API_KEY=
XAI_MODEL=

# Ollama (optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# ---------- Tools ----------
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxx

# ---------- Database ----------
# Matches docker-compose.yml. Leave empty to run without Postgres (memory is lost on restart).
DATABASE_URL=postgresql://user:password@localhost:5432/lecturer_db

# ---------- App ----------
MAX_REVISIONS=3
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# ---------- LangSmith (optional) ----------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_xxxxxxxxxxxxxxxxxxxx
LANGSMITH_PROJECT=lecturer-assistant